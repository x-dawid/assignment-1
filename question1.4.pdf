#this if for staff on board the plane to fill out, includes the variables for passengers on plane and seats occupied
#the maximum number of passengrers i 18*6 as we have 6 column and 18 rows of seats hence loop until passengers reaches 108
passengers = 0
while passengers <= 108
  passengers = input("how many passengers does plane have so for")
  seats_occupied = []
  for i in range(passengers):
    seat = input(" enter seat number {i+1} :")
    seats_occupied.append(seat)
  return seats_occupied



  repeat = 1
  while repeat = 1
    quality = input("would you like a premium or standard seat? input P or S")
    if quality == "p" or "P":
      premium_seat()
      repeat = 0
      return quality
    else if quality == "s" or "S":
       #make an array of how many rows and columns of seats there is
    row = [A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,Q,R]
    column = [1,2,3,4,5,6]
    #initial row represnted by 0
    i = 0
    #inital seat represented by 0
    j = 0 
   #for loop to go through each row 1 by 1 
   for i = 0 to 17
      #for loop to go though each column 1 by 1
      for j = 0 to 5
        #seat is given by the row the and column the seat is in, row is given by a letter column is given by a number
        seat = row[i] + column[j]
        if seat not in seats_occupied
          return seat
          break
        else
          j = j + 1
      i = i + 1
    


    


